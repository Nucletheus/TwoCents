import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

// Shell mirrors `apps/web` areas for migration. Replace placeholders as Rust logic lands.
export component MainWindow inherits Window {
  in-out property <string> current-section: "dashboard";

  pure callback render-analytics-plot() -> image;

  title: "TwoCents";
  preferred-width: 1000px;
  preferred-height: 720px;

  HorizontalBox {
    VerticalBox {
      width: 220px;
      padding: 8px;
      Text {
        text: "TwoCents";
        font-size: 18px;
        font-weight: 700;
        padding-bottom: 8px;
      }
      Button {
        text: "Dashboard";
        clicked => { root.current-section = "dashboard"; }
      }
      Button {
        text: "Accounts";
        clicked => { root.current-section = "accounts"; }
      }
      Button {
        text: "Expenses";
        clicked => { root.current-section = "expenses"; }
      }
      Button {
        text: "Budgets";
        clicked => { root.current-section = "budgets"; }
      }
      Button {
        text: "Goals";
        clicked => { root.current-section = "goals"; }
      }
      Button {
        text: "Analytics";
        clicked => { root.current-section = "analytics"; }
      }
      Button {
        text: "Settlements";
        clicked => { root.current-section = "settlements"; }
      }
      Button {
        text: "Households";
        clicked => { root.current-section = "households"; }
      }
    }

    VerticalBox {
      padding: 8px;
      analytics-panel := Rectangle {
        visible: root.current-section == "analytics";
        vertical-stretch: 1;
        background: @linear-gradient(180deg, #0f1419 0%, #1a1f2e 100%);
        border-radius: 6px;
        VerticalBox {
          padding: 8px;
          Text {
            text: "Analytics (plotters)";
            color: #e8e8e8;
            font-size: 16px;
            font-weight: 600;
            padding-bottom: 6px;
          }
          Image {
            source: root.render-analytics-plot();
            height: 420px;
          }
        }
      }
      other-panel := Rectangle {
        visible: !(root.current-section == "analytics");
        vertical-stretch: 1;
        background: #f5f5f5;
        border-radius: 6px;
        VerticalBox {
          padding: 12px;
          Text {
            text: root.current-section == "dashboard" ? "Dashboard: replace Next /dashboard. Same metrics, local data." : root.current-section == "accounts" ? "Accounts: replace apps/web/accounts + DB accounts table." : root.current-section == "expenses" ? "Expenses: replace apps/web + splits. CSV/imports port to Rust." : root.current-section == "budgets" ? "Budgets: replace apps/web and budget_sets / scenarios." : root.current-section == "goals" ? "Goals: replace apps/web goals + savings goal logic." : root.current-section == "settlements" ? "Settlements: port packages/shared settlements code." : root.current-section == "households" ? "Households: port membership, colors, invite. Local store first." : "Pick a section.";
            wrap: word-wrap;
          }
        }
      }
    }
  }
}
