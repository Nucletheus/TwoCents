NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_supabase_anon_key
NEXT_PUBLIC_ENABLE_SIGNUP=false

# Standalone: omit or any value except "false" = no sign-in UI. Set to false for hosted / password login.
# NEXT_PUBLIC_STANDALONE_MODE=false
STANDALONE_AUTH_EMAIL=local@twocents.local
STANDALONE_AUTH_PASSWORD=change-me
